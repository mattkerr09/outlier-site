# Build ARTIFACTS only. The generator SOURCE under _seo_build/scripts and
# _seo_build/templates is tracked: it renders 50+ live pages, and while it was
# ignored wholesale the only copy of it existed on one machine.
_seo_build/output/
*.pyc
__pycache__/
# Local pre-deploy backup snapshots of index.html (e.g. index.html.pre11178).
# Never deploy these — some contain scrubbed banned copy ("unlocks"/"Frontier").
index.html.pre*

.DS_Store
**/.DS_Store
