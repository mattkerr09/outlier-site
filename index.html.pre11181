<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="data:image/png;base64,">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Outlier — Unlimited local AI. Offline on your Mac.</title>
  <meta name="description" content="Outlier is building a local AI platform for Mac with no API token caps: private by default, offline-capable, and community-funded. Free Nano + Lite. Standard $149 once adds Quick, Core, Code, Vision. Pro $30/mo or $249/yr adds Plus 397B.">
  <meta name="theme-color" content="#07060b">
  <meta property="og:title" content="Outlier — Unlimited tokens. Offline on your Mac.">
  <meta property="og:description" content="A local AI platform for Mac with no API token caps. Free Nano + Lite. Standard $149 once. Pro $30/mo or $249/yr. Founders fund the build.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://outlier.host">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Outlier — Unlimited tokens on your Mac.">
  <meta name="twitter:description" content="Local AI on Mac with no API token caps. Help us build the offline coding-agent platform.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@500,700,900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #07060b;
      --surface: #0e0d14;
      --surface-2: #15131e;
      --surface-3: #1c1928;
      --border: rgba(168,85,247,0.08);
      --border-hover: rgba(168,85,247,0.18);
      --text: #f0eef5;
      --text-mid: #a8a3b5;
      --text-dim: #6e6880;
      --accent: #A855F7;
      --accent-light: #C084FC;
      --accent-deep: #7C3AED;
      --accent-soft: rgba(168,85,247,0.10);
      --accent-border: rgba(168,85,247,0.20);
      --green: #34d399;
      --green-light: #6ee7b7;
      --green-soft: rgba(52,211,153,0.08);
      --green-border: rgba(52,211,153,0.22);
      --amber: #fbbf24;
      --amber-light: #fcd34d;
      --amber-soft: rgba(251,191,36,0.08);
      --amber-border: rgba(251,191,36,0.22);
      --red-soft: rgba(239,68,68,0.06);
      --red-border: rgba(239,68,68,0.18);
      --red: #f87171;
      --display: 'Clash Display';
      --head: 'Satoshi', 'DM Sans', -apple-system, sans-serif;
      --sans: 'DM Sans', -apple-system, sans-serif;
      --mono: 'JetBrains Mono', ui-monospace, monospace;
      --radius: 14px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; overflow-x: hidden; }
    body {
      background: var(--bg); color: var(--text);
      font-family: var(--sans); font-size: 17px; line-height: 1.65;
      -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    ::selection { background: rgba(168,85,247,0.30); }
    a { color: var(--accent-light); text-decoration: none; transition: color 0.2s; }
    a:hover { color: var(--text); }

    .wrap { width: min(1120px, calc(100% - 3rem)); margin: 0 auto; }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(7,6,11,0.82);
      backdrop-filter: blur(24px) saturate(1.6);
      border-bottom: 1px solid var(--border);
    }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 72px; }
    .nav-logo { height: 40px; width: auto; display: block; }
    .nav-links { display: flex; list-style: none; gap: 1.4rem; align-items: center; }
    .nav-links a { font-size: 0.95rem; font-weight: 500; color: var(--text-dim); transition: color 0.2s; }
    .nav-links a:hover { color: var(--text); }
    .nav-cta {
      background: var(--green) !important; color: #051b11 !important;
      padding: 0.48rem 1.1rem; border-radius: 8px;
      font-size: 0.95rem !important; font-weight: 700 !important;
      transition: all 0.2s; display: inline-flex !important; align-items: center; gap: 0.35rem;
    }
    .nav-cta:hover { filter: brightness(1.1); color: #051b11 !important; transform: translateY(-1px); }

    .ship-pill {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-family: var(--mono); font-size: 0.74rem; font-weight: 500;
      color: var(--amber-light); padding: 0.25rem 0.6rem;
      border: 1px solid var(--amber-border); border-radius: 100px;
      background: var(--amber-soft);
    }
    .ship-pill::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
      background: var(--amber); box-shadow: 0 0 8px var(--amber);
      animation: pulse 2s ease-in-out infinite;
    }

    /* HERO */
    .hero { padding: 4.5rem 0 3.5rem; position: relative; text-align: center; overflow: hidden; }
    .hero::before {
      content: ''; position: absolute; top: -30%; left: 50%; transform: translateX(-50%);
      width: 1100px; height: 700px;
      background: radial-gradient(ellipse, rgba(168,85,247,0.09), transparent 65%);
      pointer-events: none;
    }
    .hero::after {
      content: ''; position: absolute; top: 10%; right: -10%; width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(52,211,153,0.04), transparent 60%);
      pointer-events: none;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: var(--surface-2); border: 1px solid var(--accent-border);
      padding: 0.32rem 0.85rem; border-radius: 100px;
      font-size: 0.88rem; font-weight: 600; color: var(--accent-light);
      margin-bottom: 2rem; position: relative;
    }
    .hero-badge-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 10px rgba(168,85,247,0.5);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

    .hero h1 {
      font-family: var(--head);
      font-size: clamp(3rem, 7vw, 5.6rem);
      font-weight: 900; letter-spacing: -0.045em; line-height: 1.02;
      margin: 0 auto 1.4rem; max-width: 14ch; position: relative;
    }
    .hero h1 .gradient {
      background: linear-gradient(135deg, var(--accent-light), var(--accent));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .hero h1 .green-g {
      background: linear-gradient(135deg, #34d399, #10b981);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .hero-sub {
      font-size: 1.24rem; color: var(--text-mid);
      max-width: 60ch; margin: 0 auto 2.2rem; line-height: 1.65; position: relative;
    }
    .hero-sub strong { color: var(--text); font-weight: 600; }
    .hero-actions {
      display: flex; gap: 0.7rem; flex-wrap: wrap; justify-content: center;
      margin-bottom: 1.6rem; position: relative;
    }
    .btn {
      display: inline-flex; align-items: center; gap: 0.45rem;
      padding: 0.95rem 1.9rem; border-radius: 10px; font-size: 1.02rem;
      font-weight: 600; border: none; cursor: pointer; transition: all 0.22s;
      font-family: var(--sans); text-decoration: none;
    }
    .btn-green {
      background: var(--green); color: #051b11;
      box-shadow: 0 2px 24px rgba(52,211,153,0.22);
    }
    .btn-green:hover { filter: brightness(1.08); transform: translateY(-2px); color: #051b11; box-shadow: 0 6px 28px rgba(52,211,153,0.35); }
    .btn-accent {
      background: var(--accent); color: #fff;
      box-shadow: 0 2px 20px rgba(168,85,247,0.25);
    }
    .btn-accent:hover { filter: brightness(1.1); transform: translateY(-2px); color: #fff; box-shadow: 0 6px 28px rgba(168,85,247,0.38); }
    .btn-ghost {
      background: var(--surface-2); color: var(--text-mid); border: 1px solid var(--border);
    }
    .btn-ghost:hover { border-color: var(--accent-border); color: var(--text); transform: translateY(-2px); }

    .req { font-family: var(--mono); font-size: 0.78rem; color: var(--text-dim); position: relative; }

    /* PROOF STRIP */
    .proof {
      margin-top: 4rem; padding: 1.4rem 2rem;
      border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
      background: var(--surface);
      display: flex; justify-content: space-around; align-items: center;
      flex-wrap: wrap; gap: 1.5rem; position: relative;
    }
    .proof-item { text-align: center; }
    .proof-num {
      font-family: var(--head); font-size: 1.6rem; font-weight: 800;
      letter-spacing: -0.02em; color: var(--text); line-height: 1;
    }
    .proof-num.green { color: var(--green); }
    .proof-num.purple { color: var(--accent-light); }
    .proof-label {
      font-family: var(--mono); font-size: 0.72rem; color: var(--text-dim);
      text-transform: uppercase; letter-spacing: 0.08em; margin-top: 0.35rem;
    }

    /* WAITLIST BANNER */
    .waitlist-banner {
      background: linear-gradient(135deg, rgba(251,191,36,0.08), rgba(168,85,247,0.06));
      border-top: 1px solid var(--amber-border);
      border-bottom: 1px solid var(--amber-border);
      padding: 0.85rem 1rem;
      text-align: center;
      font-size: 0.95rem;
      color: var(--text-mid);
      position: relative;
      overflow: hidden;
    }
    .waitlist-banner .banner-inner { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; }
    .waitlist-banner strong { color: var(--amber-light); font-weight: 600; }
    .waitlist-banner a { color: var(--green-light); font-weight: 600; margin-left: 0.5rem; white-space: nowrap; }
    .waitlist-banner a:hover { color: var(--green); }

    /* SECTIONS */
    section.block { padding: 5.5rem 0; border-top: 1px solid var(--border); }
    .shead { text-align: center; margin-bottom: 3rem; }
    .stag {
      display: inline-block;
      font-family: var(--mono); font-size: 0.74rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--accent); margin-bottom: 0.9rem;
      padding: 0.2rem 0.7rem; background: var(--accent-soft);
      border: 1px solid var(--accent-border); border-radius: 100px;
    }
    .stag.green { color: var(--green); background: var(--green-soft); border-color: var(--green-border); }
    .stag.amber { color: var(--amber); background: var(--amber-soft); border-color: var(--amber-border); }
    section h2 {
      font-family: var(--head); font-weight: 900;
      font-size: clamp(2rem, 4vw, 3rem);
      letter-spacing: -0.035em; line-height: 1.08;
      color: var(--text); margin: 0 auto 0.8rem; max-width: 22ch;
    }
    section h2 em, section h2 .gradient {
      font-style: normal;
      background: linear-gradient(135deg, var(--accent-light), var(--accent));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    section h2 .green-g {
      font-style: normal;
      background: linear-gradient(135deg, #34d399, #10b981);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .slead {
      font-size: 1.15rem; color: var(--text-mid); max-width: 62ch;
      line-height: 1.7; margin: 0 auto;
    }
    .slead strong { color: var(--text); font-weight: 600; }

    /* PAIN / BENEFITS */
    .pain-grid {
      display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;
      margin-top: 1rem;
    }
    .pain-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 2rem 1.8rem;
      transition: all 0.25s;
    }
    .pain-card:hover { border-color: var(--accent-border); transform: translateY(-3px); }
    .pain-card .then {
      display: inline-block; font-family: var(--mono); font-size: 0.72rem;
      text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--red); background: var(--red-soft);
      border: 1px solid var(--red-border); border-radius: 6px;
      padding: 0.15rem 0.5rem; margin-bottom: 0.8rem;
    }
    .pain-card .now {
      display: inline-block; font-family: var(--mono); font-size: 0.72rem;
      text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--green-light); background: var(--green-soft);
      border: 1px solid var(--green-border); border-radius: 6px;
      padding: 0.15rem 0.5rem; margin-bottom: 0.8rem;
    }
    .pain-card h3 {
      font-family: var(--display); font-size: 1.35rem; font-weight: 600;
      letter-spacing: -0.01em; margin-bottom: 0.7rem; line-height: 1.2;
    }
    .pain-card p { color: var(--text-mid); font-size: 1rem; line-height: 1.65; }

    /* MISSION */
    .mission-intro { text-align: center; max-width: 62ch; margin: 0 auto 3rem; }
    .phase-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
      max-width: 980px; margin: 0 auto;
    }
    .phase-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 1.8rem 1.6rem;
      transition: all 0.25s; position: relative;
    }
    .phase-card.shipping { border-color: var(--green-border); background: linear-gradient(135deg, rgba(52,211,153,0.06), transparent); }
    .phase-card.active { border-color: var(--amber-border); background: linear-gradient(135deg, rgba(251,191,36,0.06), transparent); }
    .phase-card.queued-accent { border-color: var(--accent-border); background: linear-gradient(135deg, rgba(168,85,247,0.04), transparent); }
    .phase-card:hover { transform: translateY(-3px); }
    .phase-num {
      font-family: var(--mono); font-size: 0.72rem; font-weight: 600;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--text-dim); margin-bottom: 0.4rem;
    }
    .phase-card.shipping .phase-num { color: var(--green); }
    .phase-card.active .phase-num { color: var(--amber-light); }
    .phase-card.queued-accent .phase-num { color: var(--accent-light); }
    .phase-card h3 {
      font-family: var(--display); font-size: 1.3rem; font-weight: 600;
      letter-spacing: -0.01em; color: var(--text);
      margin-bottom: 0.6rem; line-height: 1.25;
    }
    .phase-card p {
      color: var(--text-mid); font-size: 0.98rem; line-height: 1.6;
    }
    .phase-status {
      display: inline-block; font-family: var(--mono); font-size: 0.68rem;
      font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em;
      padding: 0.2rem 0.55rem; border-radius: 100px; margin-top: 1rem;
    }
    .phase-status.shipping { color: var(--green-light); background: var(--green-soft); border: 1px solid var(--green-border); }
    .phase-status.active { color: var(--amber-light); background: var(--amber-soft); border: 1px solid var(--amber-border); }
    .phase-status.queued { color: var(--accent-light); background: var(--accent-soft); border: 1px solid var(--accent-border); }
    .phase-status.queued-dim { color: var(--text-dim); background: var(--surface-2); border: 1px solid var(--border); }
    .mission-close {
      text-align: center; max-width: 60ch; margin: 3rem auto 0;
      color: var(--text-mid); font-size: 1.05rem; line-height: 1.7;
    }
    .mission-close strong { color: var(--text); font-weight: 600; }

    /* TIER TABLE */
    .tier-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); }
    .tier { width: 100%; border-collapse: collapse; }
    .tier th {
      font-family: var(--mono); font-size: 0.7rem; color: var(--text-dim);
      text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500;
      padding: 0.95rem 1.1rem; text-align: left;
      background: var(--surface-2); border-bottom: 1px solid var(--border);
    }
    .tier td {
      padding: 1rem 1.1rem; border-bottom: 1px solid rgba(168,85,247,0.05);
      color: var(--text-mid); font-size: 1rem; vertical-align: top;
    }
    .tier tr:last-child td { border-bottom: none; }
    .tier tr:hover td { background: rgba(168,85,247,0.03); }
    .tier tr.flagship td { background: linear-gradient(90deg, rgba(168,85,247,0.06), rgba(52,211,153,0.03)); }
    .tier .v { color: var(--text); font-weight: 700; font-family: var(--mono); font-size: 0.98rem; }
    .tier .v.hi { color: var(--accent-light); }
    .tier .v.green { color: var(--green); }
    .tier .v.tbd { color: var(--text-dim); font-size: 0.82rem; font-weight: 500; }
    .tier .tname { font-family: var(--display); font-size: 1.18rem; font-weight: 600; color: var(--text); letter-spacing: -0.01em; }
    .tier .tbase { font-family: var(--mono); font-size: 0.8rem; color: var(--text-dim); margin-top: 0.2rem; }
    .tier .tnote { font-size: 0.96rem; color: var(--text-mid); line-height: 1.5; }
    .tag-new {
      display: inline-block; font-family: var(--mono); font-size: 0.62rem;
      font-weight: 700; color: var(--green-light); background: var(--green-soft);
      border: 1px solid var(--green-border); padding: 0.1rem 0.4rem;
      border-radius: 4px; margin-left: 0.4rem; vertical-align: middle;
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    .tag-soon {
      display: inline-block; font-family: var(--mono); font-size: 0.62rem;
      font-weight: 700; color: var(--amber-light); background: var(--amber-soft);
      border: 1px solid var(--amber-border); padding: 0.1rem 0.4rem;
      border-radius: 4px; margin-left: 0.4rem; vertical-align: middle;
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    .provenance {
      font-family: var(--mono); font-size: 0.8rem; color: var(--text-dim);
      text-align: center; margin-top: 1.2rem; line-height: 1.7;
    }
    .provenance strong { color: var(--green); font-weight: 500; }

    /* VS TABLE */
    .vs-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); }
    .vs { width: 100%; border-collapse: collapse; }
    .vs th {
      font-family: var(--mono); font-size: 0.7rem; color: var(--text-dim);
      text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500;
      padding: 1rem 1rem; text-align: center;
      background: var(--surface-2); border-bottom: 1px solid var(--border);
    }
    .vs th:first-child { text-align: left; }
    .vs th.us { color: var(--accent-light); background: var(--accent-soft); }
    .vs td {
      padding: 0.9rem 1rem; border-bottom: 1px solid rgba(168,85,247,0.05);
      font-size: 0.95rem; text-align: center; color: var(--text-mid);
    }
    .vs td:first-child { text-align: left; color: var(--text); font-weight: 500; font-family: var(--display); font-size: 1rem; }
    .vs tr:last-child td { border-bottom: none; }
    .vs td.yes { color: var(--green-light); font-weight: 700; font-family: var(--mono); }
    .vs td.no { color: var(--text-dim); font-family: var(--mono); }
    .vs td.us-col { background: rgba(168,85,247,0.04); }

    /* ENERGY */
    .energy-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem; max-width: 900px; margin: 0 auto 2rem;
    }
    .energy-stat {
      background: var(--surface); border: 1px solid var(--green-border);
      border-radius: var(--radius); padding: 1.6rem 1.4rem;
      text-align: center; transition: all 0.22s;
    }
    .energy-stat:hover { transform: translateY(-3px); border-color: var(--green); }
    .energy-stat .big {
      font-family: var(--head); font-size: 2.2rem; font-weight: 900;
      color: var(--green-light); letter-spacing: -0.02em; line-height: 1;
      margin-bottom: 0.3rem;
    }
    .energy-stat .big small { font-size: 1rem; font-weight: 700; color: var(--green); }
    .energy-stat p {
      color: var(--text-mid); font-size: 0.92rem; line-height: 1.5;
      margin-top: 0.5rem;
    }
    .energy-body {
      max-width: 62ch; margin: 2rem auto 0; color: var(--text-mid);
      font-size: 1.05rem; line-height: 1.75;
    }
    .energy-body p { margin-bottom: 1rem; }
    .energy-body strong { color: var(--text); font-weight: 600; }
    .energy-sources {
      font-family: var(--mono); font-size: 0.75rem; color: var(--text-dim);
      text-align: center; margin-top: 2rem; line-height: 1.7;
    }

    /* BENCH */
    .bench-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface); }
    .bench { width: 100%; border-collapse: collapse; }
    .bench th {
      font-family: var(--mono); font-size: 0.7rem; color: var(--text-dim);
      text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500;
      padding: 0.9rem 1.1rem; text-align: left;
      background: var(--surface-2); border-bottom: 1px solid var(--border);
    }
    .bench td {
      padding: 0.85rem 1.1rem; border-bottom: 1px solid rgba(168,85,247,0.05);
      color: var(--text-mid); font-size: 0.98rem;
    }
    .bench tr:last-child td { border-bottom: none; }
    .bench .model { color: var(--text); font-weight: 600; white-space: nowrap; font-family: var(--display); }
    .bench .v { color: var(--text); font-weight: 700; font-family: var(--mono); }
    .bench .v.hi { color: var(--accent-light); }
    .bench .v.green { color: var(--green); }

    /* WAITLIST SECTION */
    .waitlist-card {
      background: linear-gradient(135deg, rgba(251,191,36,0.10), rgba(52,211,153,0.06));
      border: 1px solid var(--amber-border);
      border-radius: var(--radius);
      padding: 2.5rem 2rem;
      text-align: center;
      max-width: 640px;
      margin: 0 auto 2rem;
      position: relative;
      overflow: hidden;
    }
    .waitlist-card::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(circle, rgba(251,191,36,0.06), transparent 40%);
      pointer-events: none;
    }
    .waitlist-tag {
      display: inline-block;
      font-family: var(--mono); font-size: 0.7rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--amber-light);
      background: var(--amber-soft);
      border: 1px solid var(--amber-border);
      padding: 0.25rem 0.7rem;
      border-radius: 100px;
      margin-bottom: 1rem;
      position: relative;
    }
    .waitlist-card h3 {
      font-family: var(--display); font-weight: 700;
      font-size: 1.9rem; letter-spacing: -0.02em;
      color: var(--text); margin-bottom: 0.8rem;
      position: relative;
    }
    .waitlist-card p {
      color: var(--text-mid); font-size: 1rem;
      max-width: 480px; margin: 0 auto 1.8rem;
      line-height: 1.65; position: relative;
    }
    .waitlist-card p strong { color: var(--text); font-weight: 600; }
    .waitlist-actions {
      display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center;
      position: relative;
    }

    /* DONATE */
    .donate-intro { text-align: center; margin-bottom: 3rem; }
    .founders-card {
      background: linear-gradient(135deg, rgba(168,85,247,0.12), rgba(124,58,237,0.08));
      border: 1px solid var(--accent-border);
      border-radius: var(--radius);
      padding: 2.5rem 2rem;
      text-align: center;
      max-width: 560px;
      margin: 0 auto 2rem;
      position: relative;
      overflow: hidden;
    }
    .founders-card::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: radial-gradient(circle, rgba(168,85,247,0.08), transparent 40%);
      pointer-events: none;
    }
    .founders-tag {
      display: inline-block;
      font-family: var(--mono); font-size: 0.7rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--accent-light);
      background: var(--accent-soft);
      border: 1px solid var(--accent-border);
      padding: 0.25rem 0.7rem;
      border-radius: 100px;
      margin-bottom: 1rem;
      position: relative;
    }
    .founders-card h3 {
      font-family: var(--display); font-weight: 700;
      font-size: 2rem; letter-spacing: -0.02em;
      color: var(--text); margin-bottom: 0.5rem;
      position: relative;
    }
    .founders-price {
      font-family: var(--head); font-weight: 900;
      font-size: 3rem; letter-spacing: -0.03em;
      color: var(--accent-light);
      line-height: 1;
      margin: 0.5rem 0;
      position: relative;
    }
    .founders-price span {
      font-size: 1.1rem; font-weight: 600;
      color: var(--text-dim); letter-spacing: 0;
    }
    .founders-desc {
      color: var(--text-mid); font-size: 1rem;
      max-width: 420px; margin: 1rem auto 1.6rem;
      line-height: 1.6; position: relative;
    }
    .founders-desc strong { color: var(--text); font-weight: 600; }

    .tiers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      max-width: 980px;
      margin: 0 auto;
    }
    .tier-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.6rem 1.4rem;
      transition: all 0.22s;
      display: flex; flex-direction: column;
      position: relative;
    }
    .tier-card:hover {
      border-color: var(--accent-border);
      transform: translateY(-3px);
    }
    .tier-card-name {
      font-family: var(--display); font-weight: 600;
      font-size: 1.2rem; color: var(--text);
      letter-spacing: -0.01em;
    }
    .tier-card-price {
      font-family: var(--mono); font-weight: 600;
      color: var(--accent-light); font-size: 1.4rem;
      margin: 0.5rem 0 0.9rem;
    }
    .tier-card-price span {
      color: var(--text-dim); font-size: 0.85rem; font-weight: 400;
    }
    .tier-card-desc {
      color: var(--text-mid); font-size: 0.92rem;
      line-height: 1.55; margin-bottom: 1.2rem;
      flex-grow: 1;
    }
    .tier-card-btn {
      font-family: var(--display); font-weight: 600;
      color: var(--green); font-size: 0.95rem;
      transition: all 0.2s;
    }
    .tier-card-btn:hover { color: var(--green-light); transform: translateX(2px); }
    .donate-note {
      font-family: var(--mono); font-size: 0.78rem;
      color: var(--text-dim); text-align: center;
      margin-top: 2rem;
    }
    .donate-note a { color: var(--accent-light); }

    /* COMMUNITY */
    .community-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      max-width: 960px;
      margin: 2rem auto 0;
    }
    .comm-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 1.4rem;
      text-align: center; transition: all 0.22s;
      display: flex; flex-direction: column; align-items: center;
    }
    .comm-card.primary { border-color: var(--accent-border); background: linear-gradient(135deg, rgba(168,85,247,0.08), rgba(124,58,237,0.04)); }
    .comm-card:hover {
      border-color: var(--accent-border);
      transform: translateY(-3px);
    }
    .comm-card.primary:hover { border-color: var(--accent); }
    .comm-icon {
      font-size: 1.6rem; margin-bottom: 0.6rem;
    }
    .comm-name {
      font-family: var(--display); font-weight: 600;
      font-size: 1.05rem; color: var(--text);
      margin-bottom: 0.3rem;
    }
    .comm-desc {
      color: var(--text-dim); font-size: 0.85rem;
      font-family: var(--mono);
    }

    /* FAQ */
    .faq-grid { display: grid; gap: 0.6rem; max-width: 800px; margin: 0 auto; }
    details {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.1rem 1.4rem; transition: all 0.2s;
    }
    details[open] { border-color: var(--accent-border); }
    summary {
      font-family: var(--display); font-size: 1.08rem; font-weight: 600;
      cursor: pointer; color: var(--text); list-style: none;
      display: flex; justify-content: space-between; align-items: center;
      letter-spacing: -0.01em;
    }
    summary::after {
      content: '+'; font-family: var(--mono); color: var(--accent);
      font-size: 1.4rem; font-weight: 400; transition: transform 0.2s;
    }
    details[open] summary::after { content: '−'; }
    summary::-webkit-details-marker { display: none; }
    details > div {
      margin-top: 0.9rem; color: var(--text-mid); font-size: 0.98rem;
      line-height: 1.7; padding-top: 0.9rem; border-top: 1px solid var(--border);
    }
    details > div a { color: var(--accent-light); }

    /* FINAL CTA */
    .final-cta { text-align: center; padding: 7rem 0 6rem; position: relative; overflow: hidden; }
    .final-cta::before {
      content: ''; position: absolute; bottom: -10%; left: 50%; transform: translateX(-50%);
      width: 900px; height: 500px;
      background: radial-gradient(ellipse 55% 55% at 50% 100%, rgba(52,211,153,0.07), transparent);
      pointer-events: none;
    }
    .final-cta h2 { margin: 0 auto 1rem; position: relative; max-width: 20ch; }
    .final-cta .slead { margin: 0 auto 2rem; position: relative; }
    .final-cta-actions {
      display: flex; justify-content: center; gap: 0.7rem; flex-wrap: wrap; position: relative;
    }

    /* FOOTER */
    footer { border-top: 1px solid var(--border); padding: 2rem 0; }
    .foot {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 0.88rem; color: var(--text-dim); gap: 1.5rem;
    }
    .foot-links { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; }
    .foot-links a { color: var(--text-dim); font-size: 0.88rem; }
    .foot-links a:hover { color: var(--accent-light); }
    .foot-attrib {
      text-align: center; font-size: 0.76rem; font-family: var(--mono);
      color: var(--text-dim); margin-top: 1.2rem; line-height: 1.7;
      padding-top: 1.2rem; border-top: 1px solid var(--border);
    }

    /* INLINE CODE BOX (for Code disclosure) */
    .code-disclosure {
      font-family: var(--mono); font-size: 0.92rem;
      background: var(--surface-2); border: 1px solid var(--border);
      border-radius: 8px; padding: 1rem 1.2rem;
      margin: 1.2rem 0; line-height: 1.8;
    }

    /* NAV MOBILE */
    .nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 0.5rem; z-index: 1001; }
    .nav-toggle span { display: block; width: 24px; height: 2px; background: var(--text); margin: 5px 0; transition: all 0.3s; border-radius: 2px; }
    .nav-toggle.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
    .nav-toggle.active span:nth-child(2) { opacity: 0; }
    .nav-toggle.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

    /* RESPONSIVE */
    @media (max-width: 960px) {
      .pain-grid { grid-template-columns: 1fr; }
      .phase-grid { grid-template-columns: 1fr; }
      section.block { padding: 4rem 0; }
      .hero { padding: 4rem 0 3rem; }
    }
    @media (max-width: 700px) {
      body { font-size: 16px; }
      .wrap { width: calc(100% - 2rem); }
      .nav-toggle { display: block; }
      .nav-links {
        display: none; flex-direction: column; align-items: stretch;
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(7,6,11,0.97); backdrop-filter: blur(16px);
        padding: 5rem 2rem 2rem; gap: 0.5rem; z-index: 1000;
      }
      .nav-links.open { display: flex; }
      .nav-links li { border-bottom: 1px solid var(--border); }
      .nav-links a { display: block; padding: 1rem 0; font-size: 1.2rem !important; }
      .nav-cta { text-align: center; margin-top: 1rem; justify-content: center; }
      .nav-inner { height: 60px; }
      .nav-logo { height: 30px !important; }
      .hero { padding: 3rem 0 2.5rem; }
      .hero h1 { font-size: clamp(2.2rem, 9vw, 3rem); max-width: none; }
      .hero-sub { font-size: 1.05rem; }
      .proof { gap: 1.2rem; padding: 1.2rem 1rem; }
      .proof-num { font-size: 1.3rem; }
      .proof-label { font-size: 0.64rem; }
      section.block { padding: 3rem 0; }
      .foot { flex-direction: column; text-align: center; gap: 1rem; }
      th, td { padding: 0.65rem 0.7rem; font-size: 0.86rem; white-space: nowrap; }
      .vs th { font-size: 0.6rem; }
      .founders-card { padding: 1.8rem 1.4rem; }
      .founders-price { font-size: 2.4rem; }
      .waitlist-card { padding: 1.8rem 1.4rem; }
      .waitlist-card h3 { font-size: 1.5rem; }
      .energy-stat .big { font-size: 1.8rem; }
    }
    @media (max-width: 420px) {
      .hero h1 { font-size: 2rem; }
      .hero-sub { font-size: 0.96rem; }
    }
    @media (max-width: 720px) { .hw-grid { grid-template-columns: repeat(2, 1fr) !important; } }
    @media (pointer: coarse) {
      .btn { min-height: 48px; }
      .nav-links a { min-height: 44px; display: flex; align-items: center; }
    }

    /* STICKY FUNDING CTA */
    .sticky-raise {
      position: fixed; right: 18px; bottom: 18px; z-index: 999;
      display: flex; align-items: center; gap: 0.7rem;
      background: rgba(14,13,20,0.92); border: 1px solid var(--green-border);
      border-radius: 14px; padding: 0.75rem 0.9rem;
      box-shadow: 0 12px 40px rgba(0,0,0,0.35), 0 0 22px rgba(52,211,153,0.08);
      backdrop-filter: blur(18px);
    }
    .sticky-raise span { font-family: var(--mono); font-size: 0.72rem; color: var(--text-mid); line-height: 1.35; }
    .sticky-raise strong { color: var(--green-light); font-weight: 700; }
    .sticky-raise a { color: #051b11; background: var(--green); padding: 0.45rem 0.75rem; border-radius: 8px; font-weight: 800; font-size: 0.82rem; white-space: nowrap; }
    .split-hero {
      display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 1.2rem; align-items: stretch;
      margin-top: 2.5rem; position: relative;
    }
    .hero-panel {
      text-align: left; background: linear-gradient(135deg, rgba(168,85,247,0.09), rgba(52,211,153,0.05));
      border: 1px solid var(--accent-border); border-radius: var(--radius);
      padding: 1.4rem; min-height: 100%;
    }
    .hero-panel h3 { font-family: var(--display); font-size: 1.25rem; margin-bottom: 0.7rem; }
    .hero-panel p { color: var(--text-mid); font-size: 0.98rem; line-height: 1.65; }
    .raise-meter {
      margin: 1.2rem 0; height: 10px; border-radius: 999px; overflow: hidden;
      background: var(--surface-3); border: 1px solid var(--border);
    }
    .raise-meter span { display: block; height: 100%; width: 0%; background: linear-gradient(90deg, var(--green), var(--accent)); }
    .mini-list { display: grid; gap: 0.65rem; margin-top: 1rem; }
    .mini-list div { display: flex; gap: 0.55rem; color: var(--text-mid); font-size: 0.95rem; line-height: 1.45; }
    .mini-list b { color: var(--text); }
    .pricing-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem;
    }
    @media (max-width: 1180px) {
      .pricing-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .price-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 1.7rem 1.4rem; display: flex; flex-direction: column; min-height: 100%;
    }
    .price-card.featured { border-color: var(--green-border); background: linear-gradient(135deg, rgba(52,211,153,0.08), rgba(168,85,247,0.04)); }
    .price-card h3 { font-family: var(--display); font-size: 1.3rem; margin-bottom: 0.35rem; }
    .price { font-family: var(--head); font-size: 2.2rem; font-weight: 900; letter-spacing: -0.03em; color: var(--green-light); margin: 0.6rem 0; }
    .price small { font-size: 0.95rem; color: var(--text-dim); font-weight: 600; }
    .price-card p { color: var(--text-mid); font-size: 0.97rem; line-height: 1.6; flex: 1; }
    .price-card ul { list-style: none; margin: 1rem 0; display: grid; gap: 0.45rem; color: var(--text-mid); font-size: 0.92rem; }
    .price-card li::before { content: '✓'; color: var(--green); margin-right: 0.45rem; font-weight: 800; }
    .roadmap-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 1.4rem; position: relative;
    }
    .roadmap-card h3 { font-family: var(--display); font-size: 1.2rem; margin-bottom: 0.45rem; }
    .roadmap-card p { color: var(--text-mid); font-size: 0.95rem; line-height: 1.6; }
    .roadmap-card .num {
      font-family: var(--mono); font-size: 0.72rem; color: var(--green-light);
      text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.45rem;
    }
    @media (max-width: 960px) {
      .split-hero, .pricing-grid { grid-template-columns: 1fr; }
      .sticky-raise { left: 12px; right: 12px; bottom: 12px; justify-content: space-between; }
    }

  </style>
  <!-- Privacy-friendly analytics by Plausible -->
  <script async src="https://plausible.io/js/pa-ge9NbG73lSHpzh6SU4l7j.js"></script>
